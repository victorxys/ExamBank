.evaluation-page {
  position: relative;
  min-height: 100vh;
  padding: 0 24rpx calc(210rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #effaf8;
  box-sizing: border-box;
}

.evaluation-page-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.no-margin {
  margin-top: 0;
}

.eval-hero {
  position: relative;
  height: 284rpx;
  margin: 0 -24rpx;
  overflow: hidden;
  box-shadow: none;
  box-sizing: border-box;
  z-index: 1;
}

.eval-hero-img {
  width: 100%;
  height: 100%;
}

.eval-hero-copy {
  position: absolute;
  left: 48rpx;
  top: 54rpx;
  z-index: 1;
  max-width: 360rpx;
}

.eval-hero-title {
  color: #102138;
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
}

.eval-hero-desc {
  margin-top: 12rpx;
  color: #40516b;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.eval-hero-accent {
  width: 66rpx;
  height: 8rpx;
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #16b8a7;
}

.summary-card,
.form-card {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(196, 228, 224, 0.86);
  box-shadow: 0 14rpx 36rpx rgba(35, 89, 103, 0.08);
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.summary-main {
  min-width: 0;
  flex: 1;
}

.summary-label,
.section-desc,
.counter {
  color: #718096;
  font-size: 23rpx;
  line-height: 32rpx;
}

.summary-title {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.summary-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
  word-break: break-word;
}

.summary-score {
  flex: none;
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  border-radius: 26rpx;
  background: #fff7ed;
  color: #f59e0b;
}

.summary-score-num {
  font-size: 52rpx;
  line-height: 108rpx;
  font-weight: 950;
}

.summary-score-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  margin: 0;
  color: #0f172a;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.section-desc {
  margin-top: 6rpx;
}

.rating-pill {
  flex: none;
  margin-top: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 850;
}

.star-row {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12rpx;
}

.star {
  width: 100%;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #cbd5e1;
}

.star.active {
  background: #fff7ed;
  color: #f59e0b;
}

.star-icon-img {
  width: 46rpx;
  height: 46rpx;
}

.tag-section {
  margin-top: 20rpx;
}

.tag-section-title {
  color: #334155;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 850;
}

.tag-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.tag-chip {
  min-width: 0;
  min-height: 58rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-chip.active {
  background: #e5faf6;
  color: #0f766e;
}

.tag-chip.improve.active {
  background: #fff7ed;
  color: #c2410c;
}

.quick-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.quick-chip {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 24rpx;
  line-height: 36rpx;
  border: 1rpx solid #e2e8f0;
}

.comment-input {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e1e8;
  background: #fff;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 40rpx;
}

.success-card {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 800;
  text-align: center;
}

.submit-bar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(237, 245, 242, 0.94);
  border-top: 1rpx solid rgba(203, 213, 225, 0.7);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #0f9f8f;
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 900;
}
