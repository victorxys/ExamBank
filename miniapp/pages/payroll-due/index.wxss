page {
  background: #f2faf8;
}

.payroll-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  color: #071225;
}

.payroll-hero {
  position: relative;
  min-height: 194rpx;
  padding: 34rpx 34rpx 28rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 44rpx rgba(17, 126, 116, 0.15);
  box-sizing: border-box;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-copy,
.hero-status {
  position: relative;
  z-index: 1;
}

.hero-copy {
  max-width: 430rpx;
}

.hero-title {
  color: #fff;
  font-size: 32rpx;
  line-height: 56rpx;
  font-weight: 600;
  text-shadow: 0 3rpx 10rpx rgba(0, 78, 72, 0.12);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-date,
.hero-customer {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 400;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inline-calendar-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  flex: none;
}

.hero-customer {
  margin-top: 8rpx;
}

.hero-status {
  position: absolute;
  top: 40rpx;
  right: 24rpx;
  min-width: 100rpx;
  height: 38rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 3rpx solid #ffb648;
  background: rgba(255, 255, 255, 0.94);
  color: #f59e0b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 20rpx;
  font-weight: 600;
}

.hero-status.confirmed {
  border-color: #86efac;
  color: #047857;
}

.hero-status.estimated {
  border-color: #fdba74;
  color: #c2410c;
}

.readonly-tip {
  margin: 18rpx 0 0;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.estimate-tip {
  background: #fff7ed;
  color: #b45309;
}

.share-payroll-btn {
  margin: 18rpx 0 0;
  width: 100%;
  height: 78rpx;
  border-radius: 18rpx;
  background: #0f9f8f;
  color: #fff;
  font-size: 28rpx;
  line-height: 78rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(15, 159, 143, 0.2);
}

.share-payroll-btn::after {
  border: 0;
}

.summary-card,
.calc-card,
.bank-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(222, 232, 236, 0.92);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(35, 89, 103, 0.08);
  box-sizing: border-box;
}

.summary-card {
  text-align: center;
}

.summary-label {
  color: #848484;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.amount-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #020817;
}

.currency {
  margin-right: 8rpx;
  font-size: 46rpx;
  line-height: 1;
  font-weight: 900;
}

.amount {
  font-size: 72rpx;
  line-height: 86rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.auto-line {
  margin-top: 18rpx;
  color: #70819a;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.check-dot-img {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.summary-divider {
  margin: 26rpx 0 24rpx;
  height: 1rpx;
  background: #e2e8f0;
}

.stats-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 1rpx minmax(0, 1fr) 1rpx minmax(0, 1fr);
  align-items: center;
}

.stat-item {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.stat-sep {
  height: 64rpx;
  background: #dbe4eb;
}

.stat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-item.work .stat-icon {
  color: #5f5f5f;
  background: #eef2ff;
}

.stat-item.overtime .stat-icon {
  color: #059669;
  background: #e6f8ef;
}

.stat-item.leave .stat-icon {
  color: #ea580c;
  background: #fff3ea;
}

.stat-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.stat-value {
  font-size: 40rpx;
  line-height: 44rpx;
  font-weight: 900;
  white-space: nowrap;
}

.stat-value text {
  margin-left: 4rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.stat-item.work .stat-value {
  color: #5f5f5f;
}

.stat-item.overtime .stat-value {
  color: #059669;
}

.stat-item.leave .stat-value {
  color: #ea580c;
}

.stat-label {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  text-align: left;
}

.attendance-link {
  min-height: 72rpx;
  margin-top: 26rpx;
  border: 1rpx solid #d9e2ea;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #059669;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.attendance-link-icon-img {
  width: 28rpx;
  height: 34rpx;
  margin-left: 16rpx;
  flex: none;
}

.attendance-arrow-img {
  margin-left: auto;
  margin-right: 24rpx;
  width: 38rpx;
  height: 38rpx;
  flex: none;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  color: #071225;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 900;
}

.info-dot-img {
  width: 30rpx;
  height: 30rpx;
  flex: none;
}

.formula-box {
  margin-top: 22rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dfe8ec;
  background: linear-gradient(135deg, #fbfefe, #f8fcfb);
}

.formula-grid {
  display: grid;
  grid-template-columns: minmax(92rpx, 1fr) 34rpx minmax(80rpx, 0.85fr) 34rpx minmax(150rpx, 1.35fr);
  align-items: end;
  gap: 10rpx;
}

.formula-cell {
  min-width: 0;
  text-align: center;
}

.formula-label {
  color: #718198;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.formula-value {
  margin-top: 18rpx;
  color: #071225;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 600;
  white-space: nowrap;
}

.formula-cell.wide .formula-value {
  font-size: 34rpx;
}

.operator {
  padding-bottom: 2rpx;
  color: #071225;
  font-size: 36rpx;
  line-height: 42rpx;
  font-weight: 600;
  text-align: center;
}

.plus {
  color: #10b981;
}

.formula-divider {
  margin: 24rpx 0;
  height: 1rpx;
  border-top: 2rpx dashed #cde3e2;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #718198;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.result-amount {
  min-width: 0;
  color: #071225;
  font-size: 38rpx;
  line-height: 46rpx;
  font-weight: 600;
  text-align: right;
  word-break: break-word;
}

.formula-note {
  margin-top: 22rpx;
  padding-left: 24rpx;
  color: #718198;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 700;
}

.bank-card {
  margin-bottom: 18rpx;
}

.bank-panel {
  margin-top: 24rpx;
  border: 1rpx solid #dfe7ec;
  border-radius: 14rpx;
  overflow: hidden;
  background: #fff;
}

.bank-row {
  min-height: 84rpx;
  padding: 0 22rpx;
  display: grid;
  grid-template-columns: 48rpx 132rpx minmax(0, 1fr) 104rpx;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid #edf2f5;
}

.bank-row:last-child {
  border-bottom: 0;
}

.bank-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bank-icon.person {
  color: #10b981;
  background: #e4f8ef;
}

.bank-icon.bank-account-icon {
  color: #10b981;
  background: #e4f8ef;
}

.bank-icon-img {
  width: 24rpx;
  height: 24rpx;
}

.bank-card-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.bank-label {
  color: #718198;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  white-space: nowrap;
}

.bank-value {
  min-width: 0;
  color: #071225;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 900;
  word-break: break-word;
}

.bank-value.account {
  letter-spacing: 2rpx;
}

.copy-btn {
  height: 50rpx;
  border: 2rpx solid #059669;
  border-radius: 999rpx;
  color: #059669;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.bank-name {
  padding: 0 22rpx 18rpx 84rpx;
  color: #94a3b8;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.warn-line {
  min-height: 58rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #c2410c;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.warn-icon-img {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.empty-state {
  margin-top: 220rpx;
  padding: 46rpx 32rpx;
  border-radius: 22rpx;
  border: 1rpx solid #dce9e6;
  background: rgba(255, 255, 255, 0.94);
  text-align: center;
  box-shadow: 0 14rpx 34rpx rgba(35, 89, 103, 0.07);
}

.empty-title {
  color: #071225;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 40rpx;
}

.bottom-safe {
  height: 178rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.bottom-bar {
  position: fixed;
  width: 100%;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(-20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.confirm-tip {
  margin-bottom: 14rpx;
  color: #718198;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 600;
  text-align: center;
}

.confirm-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  height: 66rpx;
  border-radius: 99rpx;
  background: linear-gradient(135deg, #059669, #059669);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 600;
  box-shadow: 0 18rpx 34rpx rgba(79, 70, 229, 0.24);
}

.confirm-btn.confirmed {
  background: #94a3b8;
  box-shadow: none;
}

.confirm-btn::after {
  border: 0;
}
