# 复制为生产 Compose 目录的 .env；生产文件不要提交 Git。
# BACKEND_IMAGE、WEB_IMAGE、RELEASE_TAG 放入独立 release.env。
APP_DATA_DIR=/Users/victor/services/examdb/data
LEGACY_PROJECT_ROOT=/Users/victor/development/ExamBank
LEGACY_DEVELOP_ROOT=/Users/victor/develop/examdb
APP_UID=501
APP_GID=20
WEB_PORT=18081
POSTGRES_DB=ExamDB_prod
POSTGRES_USER=examdb
# 使用独立的随机十六进制密码，避免 URI 中的特殊字符。
POSTGRES_PASSWORD=replace_with_random_hex_password
REDIS_PASSWORD=replace_with_another_random_hex_password
# 仅首次初始化或计划升级数据库时拉取；应用自动发布不会重建它们。
POSTGRES_IMAGE=postgres:17-bookworm
REDIS_IMAGE=redis:8-bookworm
VIDEO_ENCODING_THREADS=2
